# Copy to .env.local and adjust. The app ships with local-dev defaults,
# so this file is optional for local development.
# MongoDB Atlas: replace <user>, <password> and <cluster> with your own.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/klaunec
JWT_SECRET=change_me_to_a_long_random_string
CRON_SECRET=change_me_cron_secret
NEXT_PUBLIC_APP_NAME=KLAUN-EC

# OxaPay live merchant API key (required for checkout).
# Get this key from your live OxaPay merchant dashboard.
OXAPAY_API_KEY=
